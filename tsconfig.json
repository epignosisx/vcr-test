{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 22",

  "include": ["src"],
  "exclude": ["vitest.config.mts"],

  "compilerOptions": {
    "lib": ["es2022", "esnext.disposable"],
    "types": ["node"],
    "module": "nodenext",
    "target": "es2022",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "nodenext",
    "declaration": true,
    "sourceMap": true,

    "rootDir": "./src",
    "outDir": "./dist"
  }
}